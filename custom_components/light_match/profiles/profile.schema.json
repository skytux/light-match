{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skytux/light-match/custom_components/light_match/profiles/profile.schema.json",
  "title": "Light Match lamp profile",
  "description": "A lamp model profile in the Light Match database: how Home Assistant identifies the lamp, its capabilities, where the data comes from and, optionally, calibrated cells in the reference space lm-ref-1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "revision",
    "name",
    "license",
    "device",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "light_match_profile"
    },
    "version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "format_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Layout of this file; missing means 1. Light Match migrates older formats and shows newer ones read-only. Written as the lowest format that holds the file: 3 only with camera details."
    },
    "app_version": {
      "type": "string",
      "maxLength": 40,
      "description": "The Light Match release that wrote the file."
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "description": "How the profile was calibrated.",
      "properties": {
        "method": {
          "enum": ["spec", "imported", "by_eye", "lux_meter", "colorimeter", "camera"]
        },
        "screen_conditions_confirmed": {
          "type": "boolean",
          "description": "The calibrator confirms the recommended screen conditions (good practice badge, a small ranking boost)."
        },
        "screen_matched": {
          "type": "boolean",
          "description": "The screen brightness was matched to the lamp at 100 % before calibrating."
        },
        "reference_device": {
          "type": "string",
          "maxLength": 80,
          "description": "The phone or screen used."
        },
        "instrument": {
          "type": "string",
          "maxLength": 80,
          "description": "Lux meter or colorimeter, if any."
        },
        "camera_locked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wb", "exposure"],
          "description": "Method camera (format 3): whether the browser could lock the camera's white balance and exposure.",
          "properties": {"wb": {"type": "boolean"}, "exposure": {"type": "boolean"}}
        },
        "camera_reference": {
          "enum": ["lamp", "absolute"],
          "description": "Method camera: measured against a reference lamp in the same frame, or against the lm-ref-1 values directly (rougher)."
        },
        "camera_corrected": {
          "type": "boolean",
          "description": "Method camera: a camera to sRGB correction from screen patches was used."
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Free text from the calibrator."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Raise by one with every change to the file."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "CC-BY-4.0",
      "description": "Profile data is shared under Creative Commons Attribution 4.0; contributors are credited by nickname."
    },
    "contributors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contributor"
      }
    },
    "discussion": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/",
      "description": "The profile's GitHub Discussion, where people rate it and report how it works for them."
    },
    "target": {
      "const": "lm-ref-1",
      "description": "The space the cells are calibrated in. Only the reference space is accepted in the database."
    },
    "reference": {
      "type": "boolean",
      "description": "Lamps of this profile can serve as the by-eye reference for lm-ref-1."
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturer",
        "models"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "description": "As Home Assistant's device registry reports it."
        },
        "manufacturer_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Model names or model ids as the device registry reports them; \"*\" for every model of the manufacturer."
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": "Home Assistant integration domains; empty for any."
        },
        "firmware": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "string"
            },
            "max": {
              "type": "string"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color_modes": {
          "type": "array",
          "items": {
            "enum": [
              "onoff",
              "brightness",
              "color_temp",
              "hs",
              "xy",
              "rgb",
              "rgbw",
              "rgbww",
              "white"
            ]
          }
        },
        "brightness_floor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Lowest Home Assistant brightness the lamp really dims to."
        },
        "min_kelvin": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 20000
        },
        "max_kelvin": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 20000
        },
        "gamut": {
          "oneOf": [
            {
              "enum": [
                "A",
                "B",
                "C"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "red",
                "green",
                "blue"
              ],
              "properties": {
                "red": {
                  "$ref": "#/$defs/xy"
                },
                "green": {
                  "$ref": "#/$defs/xy"
                },
                "blue": {
                  "$ref": "#/$defs/xy"
                }
              }
            }
          ]
        },
        "subfloor": {
          "enum": [
            "channel_scale",
            "none"
          ],
          "description": "How to go below the brightness floor: scale the colour channels at the floor brightness, or not at all."
        },
        "channel_gain": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "number",
            "minimum": 0.05,
            "maximum": 20
          },
          "description": "Relative light output per channel (r, g, b, w...); only from measurements."
        },
        "transition": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Override whether transitions are passed to the lamp; null follows the lamp."
        },
        "lumens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "output_curve": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "description": "Estimated relative light output by brightness: [[brightness 1-255, output 0-1], ...], brightness rising, output not falling. Imported curves come from power readings (quality power-proxy).",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 1,
                "maximum": 255
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "verified"
      ],
      "properties": {
        "method": {
          "enum": [
            "spec",
            "imported",
            "by_eye",
            "lux_meter",
            "colorimeter",
            "camera"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "imports": {
          "type": "array",
          "description": "For imported profiles: every public database the data came from, with its licence and what was taken.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "source_url",
              "licence",
              "copyright",
              "fields",
              "quality"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "licence": {
                "enum": [
                  "MIT",
                  "BSD-2-Clause",
                  "BSD-3-Clause",
                  "Apache-2.0"
                ]
              },
              "copyright": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "quality": {
                "enum": [
                  "measured-by-source",
                  "spec",
                  "power-proxy",
                  "estimated",
                  "derived"
                ]
              }
            }
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "enum": [
            null,
            "rgb",
            "rgbw",
            "rgbww",
            "hs",
            "color_temp",
            "brightness"
          ]
        },
        "white": {
          "enum": [
            null,
            "rgb",
            "rgbw",
            "rgbww",
            "hs",
            "color_temp",
            "brightness"
          ]
        },
        "cells": {
          "type": "object",
          "description": "The command mode of single cells that are not in their kind's mode, such as a white cell calibrated with the colour LEDs of a lamp that has colour temperature (to dim below the brightness floor, or outside the lamp's colour temperature range).",
          "propertyNames": {
            "pattern": "^(color:(red|orange|yellow|green|cyan|blue|purple|pink)|white:[0-9]+):(1|5|20|50|100)$"
          },
          "additionalProperties": {
            "enum": [
              "rgb",
              "rgbw",
              "rgbww",
              "hs",
              "color_temp",
              "brightness"
            ]
          }
        }
      }
    },
    "cells": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(color:(red|orange|yellow|green|cyan|blue|purple|pink)|white:[0-9]+):(1|5|20|50|100)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "brightness"
        ],
        "properties": {
          "brightness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "rgb_color": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rgbw_color": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 4,
            "maxItems": 4
          },
          "rgbww_color": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 5,
            "maxItems": 5
          },
          "hs_color": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "color_temp_kelvin": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 20000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "method": {
                "const": "spec"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "sources"
            ],
            "properties": {
              "sources": {
                "minItems": 1
              }
            }
          },
          "cells": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "cells"
        ],
        "properties": {
          "cells": {
            "minProperties": 1
          }
        }
      },
      "then": {
        "required": [
          "modes"
        ]
      }
    }
  ],
  "$defs": {
    "xy": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nickname",
        "role",
        "date"
      ],
      "properties": {
        "nickname": {
          "type": "string",
          "pattern": "^[^@<>\\s][^@<>]{0,38}[^@<>\\s]$|^[^@<>\\s]$",
          "description": "Chosen by the contributor and public; not a real name or email."
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "role": {
          "enum": [
            "calibrated",
            "measured",
            "verified",
            "edited"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
